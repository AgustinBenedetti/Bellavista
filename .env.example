# Copy to .dev.vars for local development (Cloudflare reads .dev.vars, not .env).
# In production these live in wrangler.jsonc "vars".

# Id of the Google Sheet (the long string between /d/ and /edit in its URL).
# Leave empty to read the local csv/ files instead of Google Sheets (dev only).
SHEET_ID=

# How long a tab is served from cache before it is refreshed (default 300 = 5 min).
CACHE_TTL_SECONDS=300
