---
import type { GroupNavEntry } from '../lib/site';

interface Props {
  entries: GroupNavEntry[];
}
const { entries } = Astro.props;
---

<nav class="groupnav" aria-label="Secciones de la carta">
  <ul class="groupnav__list">
    {
      entries.map((entry) => (
        <li>
          <a class="groupnav__link" href={entry.href} aria-current={entry.current ? 'page' : undefined}>
            {entry.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .groupnav {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--nav-h);
    background: var(--forest);
    color: var(--paper);
    box-shadow: 0 2px 0 var(--ink);
  }

  .groupnav__list {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .groupnav__list::-webkit-scrollbar {
    display: none;
  }

  .groupnav__list > li {
    flex: 1 1 auto;
    display: flex;
  }

  .groupnav__link {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 0 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    border-bottom: 4px solid transparent;
  }

  .groupnav__link:hover {
    background: rgb(251 250 246 / 0.12);
  }

  .groupnav__link[aria-current='page'] {
    border-bottom-color: var(--tape);
    background: rgb(251 250 246 / 0.16);
  }

  .groupnav__link:focus-visible {
    outline-color: var(--paper);
    outline-offset: -4px;
  }

  @media (min-width: 26rem) {
    .groupnav__link {
      font-size: 0.74rem;
      letter-spacing: 0.04em;
    }
  }

  @media (min-width: 40rem) {
    .groupnav__link {
      font-size: 0.85rem;
      letter-spacing: 0.08em;
    }
  }
</style>
