---
import { env } from 'cloudflare:workers';
import { buildFooterLinks } from '../lib/site';
import Logo from './Logo.astro';
import Sprig from './Sprig.astro';

// Links come from Worker variables; Instagram and the map only render when they hold a valid URL.
const links = buildFooterLinks({ instagramUrl: env.INSTAGRAM_URL, mapsUrl: env.MAPS_URL });
const social = links.filter((link) => link.id !== 'location');
const location = links.find((link) => link.id === 'location');

// Simple outline glyphs drawn on a 24px grid; they inherit the stroke from CSS.
const ICONS = {
  whatsapp: [
    'M3 21l1.65-4.8A9 9 0 1 1 8 19.4L3 21z',
    'M9.2 8.6c-.3.5-.3 1.4.4 2.6.8 1.4 2.2 2.8 3.9 3.4 1 .4 1.7.2 2.1-.4l.2-.8-1.7-.9-.8.7c-1-.4-1.9-1.2-2.3-2.2l.7-.8-.9-1.7-.8.1z',
  ],
  instagram: ['M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3z', 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z', 'M17.2 6.8h.01'],
  location: ['M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z', 'M12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z'],
} as const;
---

<footer class="footer">
  <Sprig variant="footer-left" />
  <Sprig variant="footer-right" />
  <div class="footer__logo" aria-hidden="true">
    <Logo size="sm" />
  </div>
  <ul class="social" aria-label="Contacto">
    {
      social.map((link) => (
        <li>
          <a
            class="social__link"
            href={link.href}
            aria-label={link.label}
            {...(link.id === 'whatsapp' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
          >
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
              {ICONS[link.id].map((d) => (
                <path d={d} />
              ))}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
  {
    location && (
      <a class="place" href={location.href} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          {ICONS.location.map((d) => (
            <path d={d} />
          ))}
        </svg>
        {location.label}
      </a>
    )
  }
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    margin-top: 2.5rem;
    padding: 2rem var(--gutter) 3.5rem;
    text-align: center;
    border-top: 6px double var(--ink);
  }

  .footer__logo {
    position: relative;
    z-index: 1;
    margin-bottom: 1.25rem;
  }

  .social {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social__link {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.12s ease;
  }

  .social__link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .social__link:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .place {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    margin-top: 1.1rem;
    padding: 0.4rem 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    color: var(--ink);
  }

  .place:hover {
    color: var(--forest-deep);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .social__link {
      transition: none;
    }
  }
</style>
