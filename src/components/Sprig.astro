---
// Decorative line-art sprig. The parent must be `position: relative`.
interface Props {
  variant: 'header-left' | 'header-right' | 'footer-left' | 'footer-right';
}
const { variant } = Astro.props;
---

<svg class="sprig" data-variant={variant} viewBox="0 0 220 300" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M110 300C108 232 112 164 104 92" vector-effect="non-scaling-stroke"></path>
    <use href="#bv-leaf" transform="translate(110 300) rotate(-4) scale(1.9)"></use>
    <use href="#bv-leaf" transform="translate(108 252) rotate(-40) scale(1.5)"></use>
    <use href="#bv-leaf" transform="translate(112 226) rotate(36) scale(1.4)"></use>
  </g>
</svg>

<style>
  .sprig {
    position: absolute;
    z-index: 0;
    width: 5.5rem;
    height: auto;
    color: var(--ink);
    pointer-events: none;
  }

  [data-variant='header-left'] {
    left: -0.4rem;
    bottom: -1.1rem;
    transform: rotate(-8deg);
  }

  [data-variant='header-right'] {
    right: -0.4rem;
    top: 0.4rem;
    transform: scaleX(-1) rotate(-14deg);
  }

  [data-variant='footer-left'],
  [data-variant='footer-right'] {
    width: 3.75rem;
  }

  [data-variant='footer-left'] {
    left: -0.2rem;
    bottom: 0;
    transform: rotate(4deg);
  }

  [data-variant='footer-right'] {
    right: -0.2rem;
    bottom: 0;
    transform: scaleX(-1) rotate(4deg);
  }

  @media (min-width: 48rem) {
    .sprig {
      width: 8rem;
    }

    [data-variant='footer-left'],
    [data-variant='footer-right'] {
      width: 6rem;
    }
  }
</style>
